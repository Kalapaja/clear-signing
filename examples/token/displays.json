{
  "$schema": "../../schemas/display.schema.json",
  "displays": [
    {
      "abi": "function transfer(address receiver, uint256 amount)",
      "title": "Transfer",
      "fields": [
        {
          "title": "$labels.sender",
          "format": "address",
          "params": [{"key": "value", "value": "$msg.sender"}]
        },
        {
          "title": "$labels.amount",
          "format": "tokenAmount",
          "params": [{"key": "token", "value": "$msg.to"}, {"key": "amount", "value": "$args.amount"}]
        },
        {
          "title": "$labels.receiver",
          "format": "address",
          "params": [{"key": "value", "value": "$args.receiver"}]
        }
      ],
      "labels": [
        {
          "locale": "en",
          "items": [
            {"key": "receiver", "value": "Receiver"},
            {"key": "amount", "value": "Amount"},
            {"key": "sender", "value": "Sender"}
          ]
        }
      ]
    },
    {
      "title": "Approve",
      "abi": "function approve(address spender, uint256 amount)",
      "fields": [
        {
          "title": "$labels.sender",
          "format": "address",
          "params": [{"key": "value", "value": "$msg.sender"}]
        },
        {
          "title": "$labels.spender",
          "format": "contract",
          "params": [{"key": "value", "value": "$args.spender"}]
        },
        {
          "title": "$labels.amount",
          "format": "tokenAmount",
          "params": [{"key": "token", "value": "$msg.to"}, {"key": "amount", "value": "$args.amount"}]
        }
      ],
      "labels": [
        {
          "locale": "en",
          "items": [
            {"key": "spender", "value": "Spender"},
            {"key": "amount", "value": "Amount"},
            {"key": "sender", "value": "Sender"}
          ]
        }
      ]
    },
    {
      "abi": "function safeTransferFrom(address from, address to, uint256 id, uint256 value, bytes data)",
      "title": "NFT Transfer",
      "fields": [
        {
          "title": "$labels.sender",
          "format": "address",
          "params": [{"key": "value", "value": "$args.from"}]
        },
        {
          "title": "$labels.amount",
          "format": "tokenAmount",
          "params": [
            {"key": "token", "value": "$msg.to"},
            {"key": "tokenId", "value": "$args.id"},
            {"key": "amount", "value": "$args.value"}
          ]
        },
        {
          "title": "$labels.receiver",
          "format": "address",
          "params": [
            {"key": "value", "value": "$args.to"}
          ]
        }
      ],
      "labels": [
        {
          "locale": "en",
          "items": [
            {"key": "receiver", "value": "Receiver"},
            {"key": "amount", "value": "Amount"},
            {"key": "sender", "value": "Sender"}
          ]
        }
      ]
    }
  ]
}
